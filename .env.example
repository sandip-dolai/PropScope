# Django settings
DEBUG=True
DJANGO_SECRET_KEY=propscope-dev-secret-key-replace-in-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# PostgreSQL & PostGIS settings
POSTGRES_DB=propscope_db
POSTGRES_USER=propscope_user
POSTGRES_PASSWORD=propscope_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis & Celery settings
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Optional AI / External APIs
GEMINI_API_KEY=
NOMINATIM_USER_AGENT=propscope-app
OSRM_URL=http://router.project-osrm.org
